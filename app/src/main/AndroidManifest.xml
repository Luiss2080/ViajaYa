<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GoRide">

        <!-- Activity Principal -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activity de Login -->
        <activity
            android:name=".controlador.ActividadLogin"
            android:theme="@style/Theme.GoRide.Login"
            android:exported="false" />

        <!-- Activity de Menú Principal -->
        <activity
            android:name=".controlador.ActividadMenuPrincipal"
            android:exported="false" />

        <!-- Activities de Usuarios -->
        <activity
            android:name=".controlador.usuario.ActividadListaUsuarios"
            android:exported="false" />

        <activity
            android:name=".controlador.usuario.ActividadFormularioUsuario"
            android:exported="false" />

    </application>

</manifest>